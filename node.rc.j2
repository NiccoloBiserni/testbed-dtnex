{{ ansible_managed | comment }}
#
# Configurazione ION per {{ node_self.name }}  ->  ipn:{{ node_self.ipn }} ({{ node_self.ip }})
# Topologia: {{ dtn_topology }} | vicini diretti: {{ node_neighbors | map(attribute='ipn') | join(', ') if node_neighbors else 'nessuno' }}
#
# File combinato per `ionstart -I node.rc`. ionstart invoca gli admin program
# in un ordine FISSO indipendente da come sono disposte le sezioni nel file
# (vedi ionstart.awk): ionadmin -> ionsecadmin -> ltpadmin -> bpadmin -> ipnadmin.
#
# Convergence layer:
#   - LOOPBACK (nodo verso se stesso): LTP su UDP, pattern standard ION
#     (vedi configs/loopback-ltp/ nei sorgenti ION).
#   - VICINI DIRETTI (link fra VM):    TCP diretto sulla rete privata.
# Solo i contatti verso i vicini diretti sono dichiarati qui: tutto il resto
# della topologia viene appreso a runtime da DTNEX.

## begin ionadmin
# Inizializzazione del nodo con i parametri di memoria
1 {{ node_self.ipn }} {{ dtn_home }}/node.ionconfig

# Avvio di rfxclock
s

# Contatto e range di loopback (necessari perche' il nodo possa
# instradare verso se stesso e comparire nel proprio contact graph)
a contact +1 +{{ ion_contact_duration }} {{ node_self.ipn }} {{ node_self.ipn }} {{ ion_contact_datarate }}
a range   +1 +{{ ion_contact_duration }} {{ node_self.ipn }} {{ node_self.ipn }} {{ ion_owlt }}
{% for nb in node_neighbors %}

# --- vicino diretto: {{ nb.name }} (ipn:{{ nb.ipn }} @ {{ nb.ip }}) ---
a contact +1 +{{ ion_contact_duration }} {{ node_self.ipn }} {{ nb.ipn }} {{ ion_contact_datarate }}
a contact +1 +{{ ion_contact_duration }} {{ nb.ipn }} {{ node_self.ipn }} {{ ion_contact_datarate }}
a range   +1 +{{ ion_contact_duration }} {{ node_self.ipn }} {{ nb.ipn }} {{ ion_owlt }}
{% endfor %}

# Tolleranza sul disallineamento di clock fra i nodi (default ION: 1s)
m clockerr {{ ion_clock_error }}
## end ionadmin

## begin ionsecadmin
# Inizializzazione del database di sicurezza (richiesta anche se non si usa BPSec)
1
## end ionsecadmin

## begin ltpadmin
# LTP e' usato SOLO per il loopback (nodo verso se stesso): e' il pattern
# standard ION per la consegna locale (vedi configs/loopback-ltp/), con
# ritrasmissione/segmentazione gestite da LTP anche se qui il link e'
# affidabile per definizione. I vicini reali usano TCP (sezione bpadmin).
1 {{ ion_ltp_init_sessions }}
a span {{ node_self.ipn }} {{ ion_ltp_max_export_sessions }} {{ ion_ltp_max_import_sessions }} {{ ion_ltp_segment_size }} {{ ion_ltp_agg_size_threshold }} {{ ion_ltp_agg_time_limit }} 'udplso 127.0.0.1:{{ ion_ltp_port }}'
s 'udplsi 0.0.0.0:{{ ion_ltp_port }}'
## end ltpadmin

## begin bpadmin
# Inizializzazione del Bundle Protocol
1

# Schema di naming IPN
a scheme ipn 'ipnfw' 'ipnadminep'

# Endpoint amministrativi e applicativi del nodo locale.
# Gli endpoint 12160 (DTNEX) e 12161 (bpecho) sono registrati a runtime
# direttamente da dtnex tramite addEndpoint(), quindi non vanno dichiarati qui.
a endpoint ipn:{{ node_self.ipn }}.0 q
a endpoint ipn:{{ node_self.ipn }}.1 q
a endpoint ipn:{{ node_self.ipn }}.2 q
a endpoint ipn:{{ node_self.ipn }}.3 q
a endpoint ipn:{{ node_self.ipn }}.4 q
a endpoint ipn:{{ node_self.ipn }}.64 q
a endpoint ipn:{{ node_self.ipn }}.65 q

# --- LTP: solo loopback ---
a protocol ltp
a induct ltp {{ node_self.ipn }} ltpcli
a outduct ltp {{ node_self.ipn }} ltpclo

# --- TCP: link verso i vicini diretti ---
a protocol tcp
a induct tcp 0.0.0.0:{{ ion_tcp_port }} tcpcli
{% for nb in node_neighbors %}
a outduct tcp {{ nb.ip }}:{{ ion_tcp_port }} ''
{% endfor %}

# Avvio dei demoni BP
s
## end bpadmin

## begin ipnadmin
# Egress plan: loopback via LTP, vicini diretti via TCP.
# DTNEX legge questa lista per sapere a chi inoltrare i propri messaggi.
a plan {{ node_self.ipn }} ltp/{{ node_self.ipn }}
{% for nb in node_neighbors %}
a plan {{ nb.ipn }} tcp/{{ nb.ip }}:{{ ion_tcp_port }}
{% endfor %}
## end ipnadmin
